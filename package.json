{
  "name": "word-league",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "npm-run-all --parallel emulators dev:next",
    "dev:next": "next dev",
    "emulators": "firebase emulators:start --only firestore,auth --project word-league-demo",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test:evaluate": "tsx tests/evaluate.test.ts",
    "validate:words": "tsx scripts/validate-word-lists.ts"
  },
  "dependencies": {
    "firebase": "^12.17.0",
    "firebase-admin": "^14.2.0",
    "next": "16.0.3",
    "npm-run-all": "^4.1.5",
    "react": "19.2.0",
    "react-dom": "19.2.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.0.3",
    "tailwindcss": "^4",
    "tsx": "^4.23.5",
    "typescript": "^5"
  }
}
